{
  /* ==========================================================================  
     GENERAL & WORKBENCH SETTINGS
     ========================================================================== */
  "redhat.telemetry.enabled": true,
  "security.workspace.trust.untrustedFiles": "open",
  "files.autoSave": "afterDelay",
  "workbench.statusBar.visible": false,
  "workbench.editor.showTabs": "multiple",
  "workbench.tree.indent": 16,
  "workbench.tree.renderIndentGuides": "none",
  "workbench.tips.enabled": false,
  "workbench.panel.showLabels": false,
  "workbench.navigationControl.enabled": false,
  "workbench.startupEditor": "none",
  "workbench.activityBar.location": "hidden",
  "workbench.preferredDarkColorTheme": "Nord Wave",
  "window.autoDetectColorScheme": true,
  "window.commandCenter": false,
  "window.newWindowProfile": "Default",
  "update.mode": "none",

  /* ==========================================================================  
     EXPLORER SETTINGS
     ========================================================================== */
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  "explorer.sortOrder": "type",
  "explorer.decorations.badges": false,
  "explorer.decorations.colors": false,
  "explorer.autoReveal": false,

  /* ==========================================================================  
     EDITOR APPEARANCE & BEHAVIOR
     ========================================================================== */
  "editor.bracketPairColorization.enabled": false,
  "breadcrumbs.enabled": false,
  "editor.overviewRulerBorder": false,
  "editor.hideCursorInOverviewRuler": true,
  "editor.occurrencesHighlight": "off",
  "editor.stickyScroll.enabled": false,
  "editor.formatOnSave": true,

  "editor.fontSize": 11.5,
  "editor.fontFamily": "Fira Code,monospace, 'Courier New'",
  "editor.fontWeight": "500",
  "editor.lineHeight": 20,
  "editor.fontLigatures": true,

  "editor.wordWrap": "wordWrapColumn",
  "editor.wordWrapColumn": 100,
  "editor.tabSize": 2,

  "editor.hover.delay": 2000,
  "editor.suggestFontSize": 11,
  "editor.suggestLineHeight": 20,

  "editor.renderLineHighlight": "none",
  "editor.renderWhitespace": "none",
  "editor.lineNumbers": "interval",
  "editor.guides.indentation": false,

  "editor.cursorSmoothCaretAnimation": "on",
  "editor.cursorBlinking": "expand",
  "editor.cursorStyle": "line-thin",
  "editor.smoothScrolling": true,

  "editor.minimap.enabled": false,
  "editor.minimap.renderCharacters": false,
  "editor.showFoldingControls": "mouseover",
  "editor.foldingHighlight": false,

  /* ==========================================================================  
     TERMINAL SETTINGS
     ========================================================================== */
  "terminal.integrated.lineHeight": 1,
  "terminal.integrated.fontSize": 11,
  "terminal.integrated.fontWeight": "500",
  "terminal.integrated.defaultProfile.windows": "Git Bash",

  /* ==========================================================================  
     JAVASCRIPT / TYPESCRIPT / FORMATTERS
     ========================================================================== */
  "javascript.updateImportsOnFileMove.enabled": "always",
  "biome.suggestInstallingGlobally": false,

  "[css]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[javascriptreact]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[javascript]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[jsonc]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[json]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[markdown]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[typescript]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[typescriptreact]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },

  /* ==========================================================================  
     THEMES, ICONS 
     ========================================================================== */
  "workbench.productIconTheme": "a-file-icon-vscode-product-icon-theme",
  "a-file-icon-vscode.saturation": 0.1,
  "workbench.iconTheme": "rose-pine-icons",

  "workbench.colorCustomizations": {
    "editorCursor.foreground": "#0ee6b0",
    "[Nord Midnight]": {
      "editor.background": "#1b1d23",
      "sideBar.background": "#1b1d23",
      "terminal.background": "#1b1d23"
    }
  },

  "editor.tokenColorCustomizations": {
    "textMateRules": [
      // Add Global Token Color Customizations
      {
        "scope": ["comment", "comment.block", "comment.line"],
        "settings": {
          "fontStyle": "",
          "foreground": "#353d42ec"
        }
      }
    ],
    /**
     * [strings, comments, functions, keywords, variables, numbers, types]
     */
    "[Rosé Pine (no italics)]": {
      "strings": "#a4f0dc"
    }
  },

  /* ==========================================================================  
     EXTENSIONS & CUSTOM CSS
     ========================================================================== */
  "code-runner.saveFileBeforeRun": true,
  "tailwind-fold.autoFold": false,
  "console-ninja.featureSet": "Community",
  "console-ninja.allowConsoleLogToTriggerPredictions": true,

  "vscode_custom_css.imports": [
    "file:///C:/custom-vscode/custom-vscode.css",
    "file:///C:/custom-vscode/vscode-script.js",
    "file:///c:/Users/dell/.vscode/extensions/brandonkirbyson.vscode-animations-2.0.7/dist/updateHandler.js"
  ],

  /* ==========================================================================  
     GIT & SOURCE CONTROL
     ========================================================================== */
  "git.decorations.enabled": false,
  "git.enableSmartCommit": true,
  "git.confirmSync": false,
  "git.openRepositoryInParentFolders": "never",
  "scm.diffDecorations": "none",

  /* ==========================================================================  
     GITHUB COPILOT
     ========================================================================== */
  "github.copilot.selectedCompletionModel": "gpt-4o-copilot",
  "github.copilot.enable": {
    "*": true,
    "plaintext": false,
    "markdown": false,
    "scminput": false
  },

  /* ==========================================================================  
     MISC SETTINGS
     ========================================================================== */
  "animations.Enabled": true
}

